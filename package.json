{
  "name": "anytub3",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AnyTub3 — IPTV décentralisée .dot avec continuité inter-hosts (Polkadot product)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "tsc -b --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "dotns:inspect": "node scripts/dotns-inspect.mjs"
  },
  "dependencies": {
